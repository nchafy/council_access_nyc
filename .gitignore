# Fetched upstream payloads — large, re-downloadable, and a moving target.
# Everything here is regenerated by the ETL; never commit it.
etl/raw/
data/raw/
data/interim/
*.pdf.cache

# Build output — regenerated by `make build`, never committed
web/data/
site/
site.building/
dist/
.vite/

# Self-check artifacts from `make shot`
screenshots/

# Checksum-verified dev tools fetched by `make axe-fetch` — see scripts/fetch_axe.py
.cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node (mapshaper is the only devDependency)
node_modules/

# Editor / OS
.DS_Store
*.swp
.idea/
